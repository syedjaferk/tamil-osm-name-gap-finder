# Copy to .env and fill in. Register the app at https://www.openstreetmap.org/oauth2/applications/new
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Must match the registered redirect URI exactly.
# Local:      http://127.0.0.1:8000/auth/callback
# Production: https://your-domain/auth/callback
OSM_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# 1 = build edits but don't upload. Set to 0 to make real edits.
DRY_RUN=1

# Host port (bound to 127.0.0.1)
PORT=8000

# --- Production (docker-compose.prod.yml) ---
# Public hostname; DNS A/AAAA record must point at this server. Ports 80 and 443 must be free.
# OSM_REDIRECT_URI is derived from it: https://$DOMAIN/auth/callback
DOMAIN=
# Required: contact for the Let's Encrypt account (expiry notices)
ACME_EMAIL=
