# Caddy gets and renews the Let's Encrypt certificate for $DOMAIN automatically.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy sends X-Forwarded-For / X-Forwarded-Proto: https by default.
	reverse_proxy app:8000
}
